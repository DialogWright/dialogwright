<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by pnpm service: the DialogWright {{what}}, run from the repository with its settings file. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{label}}</string>
  <key>ProgramArguments</key>
  <array>
{{programArguments}}
  </array>
  <key>WorkingDirectory</key>
  <string>{{root}}</string>
  <!-- The server reads the settings file itself (ENV_FILE). launchd starts with a short PATH: these hold node and pnpm.
       LOG_FILE: the server writes its own log there and rolls it (LOG_MAX_MB, LOG_KEEP in the settings file). -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>ENV_FILE</key>
    <string>{{envFile}}</string>
    <key>LOG_FILE</key>
    <string>{{logDir}}/server.log</string>
    <key>PATH</key>
    <string>{{path}}</string>
    <key>COREPACK_ENABLE_DOWNLOAD_PROMPT</key>
    <string>0</string>
  </dict>
  <!-- Start when loaded, and again whenever it exits, at most once every 10 seconds. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <!-- On stop: SIGTERM, which starts the drain, then this many seconds (DRAIN_UNREADY_MS, DRAIN_MS and 10 more) before SIGKILL. -->
  <key>ExitTimeOut</key>
  <integer>{{stopSeconds}}</integer>
  <!-- What the server prints is in LOG_FILE, rolled; launchd's own files would only grow. err.log keeps what
       goes wrong before the server reads its settings (pnpm not found, say), which is little. -->
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>{{logDir}}/err.log</string>
</dict>
</plist>
