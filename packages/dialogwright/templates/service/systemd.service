# Written by pnpm service: the DialogWright app {{app}}, run from the repository with its settings file.
[Unit]
Description=DialogWright: {{app}}
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory={{root}}
# The server reads the settings file itself (ENV_FILE), as pnpm start and pnpm diagnose do.
Environment="ENV_FILE={{envFile}}"
Environment="PATH={{path}}"
Environment="COREPACK_ENABLE_DOWNLOAD_PROMPT=0"
ExecStart={{pnpm}} --filter {{app}} serve
Restart=always
RestartSec=10
# On stop: SIGTERM to pnpm, which passes it to the server and waits while it drains; the rest of
# the service gets SIGKILL only if it is still there after TimeoutStopSec (DRAIN_MS and 10 more).
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec={{stopSeconds}}

[Install]
WantedBy=default.target
