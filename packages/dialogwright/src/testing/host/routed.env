# Example Service Line's own settings under the host file (host.yaml): the server reads only the
# variables its app.yaml and routes.yaml name from here, for this app alone; the app's code reads the
# rest by name with ctx.env (VIP_NUMBERS, the vip predicate's). Invented numbers, in the 555 range.
# SPANISH_LINE is the number whose calls start in Spanish (app.yaml's voice.numbers): the second service line.
MAIN_LINE=+15555550201
AFTER_HOURS_DESK=+15555550202
VIP_DESK=+15555550203
SPANISH_LINE=+15555550312
VIP_NUMBERS=+15555550177
