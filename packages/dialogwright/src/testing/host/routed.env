# Example Service Line's own settings under the host file (host.yaml): only the variables its
# app.yaml and routes.yaml name are read from here, for this app alone. Invented numbers, in the 555
# range. SPANISH_LINE is the number its routes put into Spanish: the second service line.
MAIN_LINE=+15555550201
AFTER_HOURS_DESK=+15555550202
VIP_DESK=+15555550203
SPANISH_LINE=+15555550312
