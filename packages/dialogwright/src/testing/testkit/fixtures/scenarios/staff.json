  },
  {
    "id": "staff-report-viewer",
    "as": "taylor",
    "steps": [
      {
        "say": "file a missing parcel report for a customer"
      }
    ],
    "expect": {
      "decision": "prompt",
      "promptId": "anything_else",
      "text": "Your role can't file reports.",
