{"id":"card-renewal-adult","version":"2026.1","approvedBy":"Branch Manager","owner":"Patron Services","on":"2025-12-10","sourceHash":"79085e7e7bf4586902ea4af948d2ac347d5943ee3567fdde429ca0a8e59258d8","hash":"f00dbd6868836e329a7d371613e5ae19e34045c3bad19c632ca7547993380216","from":"passage","sourceText":"An adult card is valid for three years. It is renewed at any branch desk with a photo ID, at no charge."}
{"id":"card-renewal-junior","version":"2026.1","approvedBy":"Branch Manager","owner":"Patron Services","on":"2025-12-10","sourceHash":"d0daf0eb5807ac5f992818768da2e035e39f72b463b6300ea29d84327ad9f959","hash":"ffa456f2d1e490c8658709d8ebfa7023d4921563717e2cb94cd42ab6285cfc00","from":"passage","sourceText":"A junior card is renewed automatically each year until its holder turns eighteen. A parent or guardian may update its details at any branch desk."}
{"id":"late-fees-adult","version":"2026.1","approvedBy":"Branch Manager","owner":"Patron Services","on":"2025-12-10","sourceHash":"a3502dd02204f66615d5227dfafdb55a5b53572022c5982f1c5e53036ee9b850","hash":"f2a183c49c4bdec0ab8b3253d90d5fd1a5a0b58a368882173ee7c6aa92a53ae7","from":"passage","sourceText":"An adult card is charged 25 cents for each day an item is overdue, up to 5 dollars for each item."}
{"id":"late-fees-adult-2025","version":"2025.1","approvedBy":"Branch Manager","owner":"Patron Services","on":"2025-12-10","sourceHash":"a14e5fbd6225ce62ba800a359103acaab10c9e7e6b1a2a3e8111cb15bd073351","hash":"7fb1aa3b93bb29b003ea4534bb1445849990f671af919de900e0bd1299c5d826","from":"passage","sourceText":"An adult card is charged 20 cents for each day an item is overdue, up to 4 dollars for each item."}
{"id":"late-fees-junior","version":"2026.1","approvedBy":"Branch Manager","owner":"Patron Services","on":"2025-12-10","sourceHash":"18345c1533866b482125f9f1f66d537d51741e4c0fce296322696bf920018b6a","hash":"83130b55c5f2be7a628620a4dcacca0dac5b6d8bfb97b4852b5816c7c65c3a03","from":"passage","sourceText":"Junior cards are not charged late fees."}
{"id":"opening-hours","version":"2026.1","approvedBy":"Branch Manager","owner":"Patron Services","on":"2025-12-10","sourceHash":"1faa2dc4c217f7cccda164cf836746cf75b4d55ffe84f087255d58cba3e67d6c","hash":"be0ce40c52aeb3f1db18d14e464e98d8c16d885e44ed070889526fd19c236a30","from":"passage","sourceText":"All branches are open Monday to Friday from 9 a.m. to 8 p.m. and on Saturday from 10 a.m. to 4 p.m. All branches are closed on Sunday."}
