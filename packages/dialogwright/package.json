{
  "name": "dialogwright",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice and chat agents that act safely: a decision model reads, code decides, every action goes through a policy gate.",
  "license": "Apache-2.0",
  "homepage": "https://dialogwright.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/DialogWright/dialogwright.git",
    "directory": "packages/dialogwright"
  },
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "dialogwright": "./src/define/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./slot-kit": "./src/slots/kit.ts",
    "./policy": "./src/define/policyEntry.ts",
    "./kb/onnx": "./src/kb/onnx.ts",
    "./*.js": "./src/*.js",
    "./*.json": "./src/*.json",
    "./*": "./src/*.ts",
    "./schemas/*.json": "./schemas/*.json"
  },
  "files": [
    "dist",
    "bin",
    "schemas",
    "templates",
    "docs",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs && tsx scripts/shipDocs.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "regress:testkit": "tsx src/testing/testkit/regress.ts",
    "schemas": "tsx src/define/schema/generate.ts",
    "slot-docs": "tsx scripts/slotDocs.ts",
    "check": "tsx src/define/cli.ts check",
    "create-app": "tsx src/define/cli.ts create-app",
    "policy:matrix": "tsx src/define/cli.ts policy:matrix",
    "policy:card": "tsx src/define/cli.ts policy:card",
    "app:diagram": "tsx src/define/cli.ts app:diagram",
    "kb:model": "tsx src/define/cli.ts kb:model",
    "kb:index": "tsx src/define/cli.ts kb:index",
    "kb:bakeoff": "tsx src/define/cli.ts kb:bakeoff",
    "kb:approve": "tsx src/define/cli.ts kb:approve",
    "kb:status": "tsx src/define/cli.ts kb:status"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "tsx": "^4.19.0",
    "undici": "^8",
    "ws": "^8.18.0",
    "yaml": "^2.9",
    "zod": "^4.6"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3",
    "vitest": ">=2.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "dialogwright": "./bin/dialogwright.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "./slot-kit": {
        "types": "./dist/slots/kit.d.ts",
        "default": "./dist/slots/kit.js"
      },
      "./policy": {
        "types": "./dist/define/policyEntry.d.ts",
        "default": "./dist/define/policyEntry.js"
      },
      "./kb/onnx": {
        "types": "./dist/kb/onnx.d.ts",
        "default": "./dist/kb/onnx.js"
      },
      "./schemas/*.json": "./schemas/*.json",
      "./package.json": "./package.json"
    }
  }
}
