{
  "name": "dialogwright",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Voice and chat agents that act safely: a decision model reads, code decides, every action goes through a policy gate.",
  "license": "Apache-2.0",
  "homepage": "https://dialogwright.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/DialogWright/dialogwright.git",
    "directory": "packages/dialogwright"
  },
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "dialogwright": "./src/define/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./*.js": "./src/*.js",
    "./*.json": "./src/*.json",
    "./*": "./src/*.ts",
    "./schemas/*.json": "./schemas/*.json"
  },
  "files": [
    "src",
    "schemas"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "regress:testkit": "tsx src/testing/testkit/regress.ts",
    "schemas": "tsx src/define/schema/generate.ts",
    "check": "tsx src/define/cli.ts check"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "undici": "^8",
    "ws": "^8.18.0",
    "yaml": "^2.9",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
