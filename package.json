{
  "name": "dialogwright-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm --filter dialogwright check",
    "create-app": "pnpm --filter dialogwright create-app",
    "verify": "pnpm typecheck && pnpm test",
    "policy:matrix": "pnpm --filter dialogwright policy:matrix",
    "policy:card": "pnpm --filter dialogwright policy:card",
    "app:diagram": "pnpm --filter dialogwright app:diagram",
    "kb:model": "pnpm --filter dialogwright kb:model",
    "kb:index": "pnpm --filter dialogwright kb:index",
    "kb:bakeoff": "pnpm --filter dialogwright kb:bakeoff",
    "kb:approve": "pnpm --filter dialogwright kb:approve",
    "kb:status": "pnpm --filter dialogwright kb:status",
    "kb:ingest": "pnpm --filter @dialogwright/kb-author kb:ingest",
    "kb:draft": "pnpm --filter @dialogwright/kb-author kb:draft",
    "kb:review": "pnpm --filter @dialogwright/kb-author kb:review",
    "kb:refresh": "pnpm --filter @dialogwright/kb-author kb:refresh",
    "kb:gaps": "pnpm --filter @dialogwright/kb-author kb:gaps",
    "audit:verify": "tsx packages/dialogwright/src/audit/verifyCli.ts",
    "diagnose": "tsx packages/dialogwright/src/server/doctor.ts",
    "configure": "tsx packages/dialogwright/src/server/setup.ts",
    "start": "tsx packages/dialogwright/src/server/start.ts",
    "service": "tsx packages/dialogwright/src/server/serviceFile.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
