node_modules/
# Runtime output (traces and audit logs) where a server or the harness runs, never source dirs
/traces/
/audit/
apps/*/traces/
apps/*/audit/
packages/*/traces/
packages/*/audit/
# A file session store (SESSION_STORE=file:sessions): what callers said, kept between turns
/sessions/
apps/*/sessions/
.env
.env.*
!.env.example
*.log
.DS_Store
coverage/
*.tmp
