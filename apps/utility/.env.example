# Copy this file to .env in this folder and fill it in. .env is git-ignored; never commit a real key.
# The launchers do not read a .env file themselves: load it into your shell first, e.g.
#   set -a && source .env && set +a
# Nothing here is needed to run the tests, the stub regression or the text CLI.

# Your TypeSafe API key, used by the live and recording clients (--client jev, --client record,
# and the server with JEV_CLIENT=jev). Recording the cassette needs it; replaying one does not.
TYPESAFE_API_KEY=

# The phone line (pnpm serve) needs these three. A 555 number is fine for local use.
# PUBLIC_HOST=
# TWILIO_AUTH_TOKEN=
# HANDOFF_NUMBER=
