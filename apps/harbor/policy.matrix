createClaim · level 2 · identity, role(service_rep refuse, office_admin person; reason broker-filing), scope(memberId), confirmed(memberId, lossType, lossDate, lossDescription), dateInRange(lossDate)
  anonymous               STEP_UP to 2
  subject@1               as anonymous
  subject@2               subject own, fields exact, confirmed none|mismatch                 BLOCK confirmation
                          subject own, fields exact, confirmed match, params covered         ALLOW
                          subject own, fields exact, confirmed match, params beforeCoverage  NEEDS_HUMAN coverage
                          subject own, fields exact, confirmed match, params tomorrow        BLOCK loss-date-future
                          subject own, fields extra|missing                                  BLOCK confirmation
                          subject inScope|outOfScope|unknown|empty                           BLOCK scope
  delegate:service_rep    BLOCK role
  delegate:office_admin   NEEDS_HUMAN broker-filing
  delegate:service_rep@1  BLOCK identity
  unlisted-role           as delegate:service_rep
  roleless                as delegate:service_rep
  other-party             as delegate:service_rep

