# policy.matrix: what the gate of "wheelshop" decides, for every action and every kind of caller.
# Written by `pnpm policy:matrix` from the compiled policy (policy.yaml, identity.yaml) and the
# app's policy matrix (TestingHooks.policyMatrix); a test fails when it differs. Never edit it by
# hand: a difference here is a change in what the agent may do, to be reviewed as the policy is.
#
# Under each action (its level and its rules as the file writes them), a row per kind of caller.
# A row with one verdict holds for every call that caller can make; otherwise its lines split it
# by what the call carries, a|b meaning either value. "as <caller>" repeats that caller's verdicts.
#
# callers
#   anonymous      no one proven (level 0)
#   subject@1      account, level 1 (one of the app's subjects)
#   subject@2      account, level 2 (one of the app's subjects)
#   unlisted-role  staff, role assistant, level 2 (a role the policy does not name)
#   roleless       staff with no role, level 2
#   other-party    visitor, level 2 (neither a subject nor of a delegate kind)
# what a call carries
#   purpose     none; entry-check, retry-check (the lifecycle's probes); a form's purpose
#   subject     own; inScope (a subject the delegates act for); outOfScope; unknown; empty
#   fields      exact; extra (one field more); missing (one field less: the subject's own when it is the only one)
#   confirmed   none; match (the caller confirmed exactly these values); mismatch
#   attempts    0; 1 (the maximum)
#   params      the policy matrix's named sets of values for the action
#   caller      kept (the call came from the matrix's caller number); none
# verdicts: ALLOW; BLOCK <reason>; STEP_UP to <level>; NEEDS_HUMAN <reason>

purposes: none

request · level 0 · identity, confirmed(callerName, vehicle, wheels, damage, diamondCut, day, window, callbackNumber)
  every caller   fields exact, confirmed none|mismatch  BLOCK confirmation
                 fields exact, confirmed match          ALLOW
                 fields extra|missing                   BLOCK confirmation

send_photo_link · level 0 · identity, confirmed(callerName, vehicle, wheels, damage, diamondCut, day, window, callbackNumber)
  every caller   fields exact, confirmed none|mismatch  BLOCK confirmation
                 fields exact, confirmed match          ALLOW
                 fields extra|missing                   BLOCK confirmation

notify_owner_request · level 0 · identity, confirmed(callerName, vehicle, wheels, damage, diamondCut, day, window, callbackNumber)
  every caller   fields exact, confirmed none|mismatch  BLOCK confirmation
                 fields exact, confirmed match          ALLOW
                 fields extra|missing                   BLOCK confirmation

book · level 1 · identity, scope(account), confirmed(account, cars, vehicles, day, window)
  anonymous      STEP_UP to 1
  subject@1      subject own, fields exact, confirmed none|mismatch  BLOCK confirmation
                 subject own, fields exact, confirmed match          ALLOW
                 subject own, fields extra|missing                   BLOCK confirmation
                 subject inScope|outOfScope|unknown|empty            BLOCK scope
  subject@2      as subject@1
  unlisted-role  BLOCK scope
  roleless       as unlisted-role
  other-party    as unlisted-role

notify_owner_booking · level 1 · identity, scope(account), confirmed(account, cars, vehicles, day, window)
  anonymous      STEP_UP to 1
  subject@1      subject own, fields exact, confirmed none|mismatch  BLOCK confirmation
                 subject own, fields exact, confirmed match          ALLOW
                 subject own, fields extra|missing                   BLOCK confirmation
                 subject inScope|outOfScope|unknown|empty            BLOCK scope
  subject@2      as subject@1
  unlisted-role  BLOCK scope
  roleless       as unlisted-role
  other-party    as unlisted-role

callback · level 0 · identity, confirmed(callbackNumber)
  every caller   fields exact, confirmed none|mismatch  BLOCK confirmation
                 fields exact, confirmed match          ALLOW
                 fields extra|missing                   BLOCK confirmation

availability · level 0 · identity
  every caller   ALLOW

lookupAccount · level 0 · identity, callerNumber(callerNumber)
  every caller   fields exact|extra, params own, caller kept    ALLOW
                 fields exact|extra, params other, caller kept  BLOCK not-caller-number
                 fields exact|extra, caller none                BLOCK no-caller-number
                 fields missing                                 BLOCK value-missing

recognizeAccount · level 0 · attempts(1)
  anonymous      attempts 0  ALLOW
                 attempts 1  NEEDS_HUMAN attempts
  subject@1      as anonymous
  subject@2      as anonymous
  unlisted-role  BLOCK not-subject
  roleless       as unlisted-role
  other-party    as unlisted-role

(unlisted) · not in the policy
  every caller   BLOCK unknown-tool
