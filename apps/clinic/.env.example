# Copy this file to apps/clinic/.env and fill it in. .env is git-ignored; never commit a real key.
# The launchers do not read a .env file themselves: load it into your shell first, e.g.
#   set -a && source apps/clinic/.env && set +a
# Nothing here is needed to run the tests, the stub regression or the text CLI.

# Your TypeSafe API key, used by the live and recording clients (--client jev, --client record,
# and the server with JEV_CLIENT=jev). Recording the cassette needs it; replaying one does not.
TYPESAFE_API_KEY=

# Where the server asks the injection screen: inline (the default; in perception's own request) or
# separate (a request of its own). A cassette replays only in the mode it was recorded in.
# SCREEN_MODE=inline
